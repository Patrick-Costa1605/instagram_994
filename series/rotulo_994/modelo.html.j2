<!doctype html>
<html lang="pt"><head><meta charset="utf-8"><style>{{ css }}</style></head>
<body>
{% set slide = s %}
<div class="slide">
  <div class="foto {{ '' if foto else 'sem-foto' }}" {% if foto %}style="background-image:url('{{ foto }}'); background-position:{{ foto_pos }}"{% endif %}></div>
  <div class="vinheta"></div>

  <div class="topo"><small>{{ cabecalho[0] }}</small><h1>{{ cabecalho[1] }}</h1></div>

  {% set linhas = slide.texto.split('|') %}
  <div class="rotulo" style="--x:{{ slide.x | default(50) }}%; --y:{{ slide.y | default(68) }}%; --rot:{{ slide.rot | default(-2) }}deg; {% if slide.cor %}--cor:{{ slide.cor }};{% endif %}">
    <div class="selo">
      <svg viewBox="0 0 100 100" aria-label="flor-de-lis">
        <g fill="#F8F3E8">
          <path d="M50 4 C 63 18 66 36 50 58 C 34 36 37 18 50 4 Z"/>
          <path d="M43 52 C 30 62 8 60 6 38 C 6 28 14 20 22 20 C 16 32 20 42 32 44 C 30 34 32 24 40 16 C 40 28 40 42 43 52 Z"/>
          <path d="M57 52 C 70 62 92 60 94 38 C 94 28 86 20 78 20 C 84 32 80 42 68 44 C 70 34 68 24 60 16 C 60 28 60 42 57 52 Z"/>
          <rect x="27" y="60" width="46" height="9" rx="4.5"/>
          <path d="M42 72 H58 L63 96 L50 87 L37 96 Z"/>
        </g>
      </svg>
    </div>
    <div class="lado">
      <div class="cima">{{ slide.etiqueta_topo | default('ALTO TEOR EM') }}</div>
      <div class="baixo l{{ linhas|length }}"><span>{% for l in linhas %}{{ l }}{% if not loop.last %}<br>{% endif %}{% endfor %}</span></div>
    </div>
  </div>

  <div class="pag"><b>{{ pag }}</b>/{{ total }}{% if pag < total %} &nbsp;→{% endif %}</div>
  {% if logo %}<img class="logo" src="{{ logo }}" style="height:{{ logo_h }}px">{% endif %}
</div>
<script>document.fonts.ready.then(() => { document.body.dataset.pronto = '1'; });</script>
</body></html>
