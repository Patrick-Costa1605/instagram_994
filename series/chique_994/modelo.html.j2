<!doctype html>
<html lang="pt"><head><meta charset="utf-8"><style>{{ css }}</style></head>
<body>
{% set cor = s.cor | default('#FFD84D') %}
{% set pos = s.pos | default('baixo') %}
<div class="slide t-{{ s.tipo | default('item') }}" style="--cor: {{ cor }}">
  {% if s.inteira and foto %}<div class="fundo-desf" style="background-image:url('{{ foto }}')"></div>{% endif %}
  <div class="foto {{ 'inteira' if s.inteira else '' }} {{ '' if foto else 'sem-foto' }}" {% if foto %}style="background-image:url('{{ foto }}'); background-position:{{ foto_pos }}"{% endif %}></div>
  <div class="sombra {{ pos }}"></div>

  <div class="bloco {{ pos }} {{ 'centro' if s.alinha == 'centro' else '' }} {{ 'pequeno' if s.pequeno else '' }}" {% if s.y %}style="top:{{ s.y }}%; bottom:auto; transform:none"{% endif %}>
    {% if s.pre %}<div class="pre">{{ s.pre }}</div>{% endif %}
    <div class="linhas">
      {% for linha in s.texto.split('|') %}<span>{% for parte_ in linha.split('*') %}{% if loop.index0 is odd %}<mark>{{ parte_ }}</mark>{% else %}{{ parte_ }}{% endif %}{% endfor %}</span>{% endfor %}
    </div>
    {% if s.nota %}<p class="nota">{{ s.nota }}</p>{% endif %}
  </div>

  <div class="marca"><b>{{ '%02d'|format(pag) }}</b> / {{ '%02d'|format(total) }}{% if pag < total %} &nbsp;→{% endif %}</div>
  {% if logo %}<img class="logo" src="{{ logo }}" style="height:{{ logo_h }}px">{% endif %}
</div>
<script>
document.fonts.ready.then(() => {
  const b = document.querySelector('.bloco'), max = 1350 * 0.6;
  const l = document.querySelector('.linhas'); let fs = parseFloat(getComputedStyle(l).fontSize);
  while (b.getBoundingClientRect().height > max && fs > 52) { fs -= 3; l.style.fontSize = fs + 'px'; }
  document.body.dataset.pronto = '1'; });
</script>
</body></html>
