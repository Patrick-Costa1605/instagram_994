<!doctype html>
<html lang="pt"><head><meta charset="utf-8"><style>{{ css }}</style></head>
{% macro prog(on) %}<div class="prog">{% for i in range(total) %}<span class="{{ 'on' if (i + 1) == on else '' }}"></span>{% endfor %}</div>{% endmacro %}
<body data-pronto="1">
{% set t = s.tipo %}
{% if t == 'capa' %}
<div class="slide capa {{ s.lado or 'esq' }}">
  {% set u = ft(s.foto) %}
  {% if s.faixa %}
  <div class="foto" style="top:0;height:930px;background:var(--tinta)"></div>
  <div style="position:absolute;left:var(--m);right:var(--m);top:150px;font-family:Fraunces,serif;font-weight:900;font-size:210px;line-height:.9;letter-spacing:-.04em;color:var(--papel)">{{ s.cabeca }}</div>
  <div style="position:absolute;left:0;top:540px;width:1080px;display:flex;height:84px">{% for f in s.faixa %}<div style="flex:1;background:{{ f.cor }};display:flex;align-items:center;padding-left:{{ 28 if loop.first else 20 }}px;font-weight:800;font-size:28px;text-transform:uppercase;color:{{ f.texto }}">{{ f.nome }}</div>{% endfor %}</div>
  <div style="position:absolute;left:0;top:640px;width:1080px;display:flex">{% for f in s.faixa %}<div style="flex:1;padding-left:{{ 28 if loop.first else 20 }}px;color:var(--papel);font-family:Fraunces,serif;font-weight:900;font-size:72px;line-height:1">{{ f.de }}</div>{% endfor %}<div style="position:absolute;right:22px;top:0;color:var(--papel);font-family:Fraunces,serif;font-weight:900;font-size:72px;line-height:1">22</div></div>
  <div style="position:absolute;left:0;top:640px;width:1080px"></div>
  {% else %}
  <div class="foto {{ 'vazia' if not u }}" style="{% if u %}background-image:url('{{ u }}');background-position:{{ s.foto_pos or '50% 50%' }};{% if s.foto_zoom %}background-size:{{ s.foto_zoom }};{% endif %}{% endif %}"></div>
  {% endif %}
  <div class="regua"></div><div class="bloco"></div>
  <div class="etiqueta">{{ s.etiqueta }}</div>
  <div class="tab">{{ s.tab|mk|safe }}</div>
  <div class="grande">{{ s.grande }}</div>
  <div class="rodape"><b>{{ s.unidade }}</b>{% if s.lema %}<i>{{ s.lema }}</i>{% endif %}</div>
  <div class="grao"></div>
</div>

{% elif t == 'sabado' %}
<div class="slide sabado">
  {% if s.foto %}{% set u = ft(s.foto) %}<div class="foto banda {{ 'vazia' if not u }}" style="{% if u %}background-image:url('{{ u }}');background-position:{{ s.foto_pos or '50% 50%' }};{% endif %}"></div>
  {% else %}<div class="foto banda cor"></div><div class="grande-txt">{{ s.grande|mk|safe }}</div>{% endif %}
  <div class="corpo"><div class="kicker">{{ s.kicker }}</div><h2>{{ s.titulo|mk|safe }}</h2>{% if s.texto %}<p>{{ s.texto|mk|safe }}</p>{% endif %}</div>
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'fazem' %}
<div class="slide fazem {{ "tres" if s.itens|length < 4 else "" }}">
  <div class="topo"><div class="kicker">{{ s.kicker or 'O que fazem' }}</div><h2>{{ s.titulo|mk|safe }}</h2></div>
  <div class="itens">{% for i in s.itens %}<div class="item"><h3>{{ i[0]|mk|safe }}</h3><p>{{ i[1] }}</p></div>{% endfor %}</div>
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'organiza' %}
<div class="slide organiza">
  <div class="topo"><div class="kicker">{{ s.kicker }}</div><h2>{{ s.titulo|mk|safe }}</h2><div class="sub">{{ s.sub }}</div></div>
  {% set com_lema = s.emblemas|selectattr('lema')|list|length > 0 %}<div class="grelha {{ 'lista' if com_lema else '' }}" style="--n:{{ s.emblemas|length }}">{% for e in s.emblemas %}<div class="e"><img src="{{ ag(e.img) }}" alt=""><div class="et"><b>{{ e.nome }}</b>{% if e.lema %}<span>{{ e.lema }}</span>{% endif %}</div></div>{% endfor %}</div>
  <div class="nota">{{ s.nota|mk|safe }}</div>
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'lema' %}
<div class="slide lema cor sobre-cor">
  <div class="kicker">{{ s.kicker or 'O lema' }}</div>
  <h2>{{ s.titulo|mk|safe }}</h2>
  <div class="sig">{{ s.texto }}</div>
  {% if parte.simbolo %}<img class="emb" src="{{ secao(parte.simbolo) }}" alt="">{% endif %}
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'convite' %}
<div class="slide convite">
  {% if s.foto %}{% set u = ft(s.foto) %}<div class="foto banda {{ 'vazia' if not u }}" style="height:640px;{% if u %}background-image:url('{{ u }}');background-position:{{ s.foto_pos or '50% 50%' }};{% endif %}"></div>
  {% else %}<div class="foto banda cor" style="height:640px"></div><div class="grande-txt" style="top:110px">{{ s.grande|mk|safe }}</div>{% endif %}
  <div class="corpo"><div class="kicker">{{ s.kicker }}</div><h2>{{ s.titulo|mk|safe }}</h2><div class="lin">{{ s.texto|mk|safe }}</div></div>
  <div class="contactos">{% for c in s.contactos %}<div><small>{{ c[0] }}</small><b>{{ c[1] }}</b></div>{% endfor %}</div>
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'faixas' %}
<div class="slide faixas">
  <div class="topo kicker" style="color:var(--tinta)">{{ s.kicker }}</div>
  {% for f in s.faixas %}<div class="f" style="top:{{ 140 + loop.index0 * 300 }}px;background:{{ f.cor }};color:{{ f.texto }}"><div class="n">{{ f.idades }}</div><div class="t"><b>{{ f.nome }}</b><span>{{ f.unidade }}</span></div></div>{% endfor %}
  <div class="grao"></div>
</div>

{% elif t == 'comum' %}
<div class="slide comum">
  {% set u = ft(s.foto) %}<div class="foto banda {{ 'vazia' if not u }}" style="{% if u %}background-image:url('{{ u }}');background-position:{{ s.foto_pos or '50% 50%' }};{% endif %}"></div>
  <div class="lista">{% for l in s.linhas %}<div>{{ l }}</div>{% endfor %}<p>{{ s.texto }}</p></div>
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'passos' %}
<div class="slide passos">
  <div class="topo kicker">{{ s.kicker }}</div>
  {% for p in s.passos %}<div class="p" style="top:{{ 190 + loop.index0 * 380 }}px"><h3>{{ p[0] }}</h3><p>{{ p[1] }}</p></div>{% endfor %}
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'meta' %}
<div class="slide meta cor sobre-cor">
  <div class="topo kicker">{{ s.kicker }}</div>
  <div class="num">{{ s.numero }}</div>
  <div class="txt">{{ s.titulo }}</div>
  <div class="sub">{{ s.texto }}</div>
  {{ prog(pag) }}<div class="grao"></div>
</div>

{% elif t == 'fim' %}
<div class="slide fim cor sobre-cor">
  <div class="topo kicker">{{ s.kicker }}</div>
  <h2>{{ s.titulo|mk|safe }}</h2>
  <div class="contactos">{% for c in s.contactos %}<div><small>{{ c[0] }}</small><b>{{ c[1] }}</b></div>{% endfor %}</div>
  <div class="sa">Sempre Alerta!</div>
  {{ prog(pag) }}<div class="grao"></div>
</div>
{% endif %}
</body></html>
