<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <style>{{ css }}</style>
</head>
<body data-pronto="1">
  <div class="page sec-{{ parte.numero }}">
    <header class="masthead">
      <span class="masthead-brand">994 · CAXINAS</span>
      <span class="masthead-unit">{{ parte.unidade_nome }} · {{ parte.unidade_patrono }}</span>
      <span class="masthead-page">{{ "%02d"|format(pag) }} / {{ "%02d"|format(total) }}</span>
    </header>

    {% if s.tipo == "capa" %}
    <main class="cover">
      <div class="cover-copy">
        <img class="cover-section-mark" src="{{ secao(parte.simbolo_secao) }}" alt="">
        <p class="eyebrow">AS NOSSAS SECÇÕES / {{ parte.unidade_nome|upper }}</p>
        <p class="section-number">0{{ parte.numero }} <span>de 04</span></p>
        <h1>{{ parte.titulo }}</h1>
        <p class="cover-age">{{ s.idade_n or s.idade }}</p>
        <p class="cover-call">{{ s.chamada or s.sub }}</p>
        <div class="cover-rule"></div>
        <p class="motto">“{{ s.lema }}”</p>
        <p class="cover-signature">Agrupamento 994 · Caxinas</p>
      </div>
      <div class="cover-photo photo" style="--photo: url('{{ foto }}'); --photo-pos: {{ foto_pos }};"></div>
      <img class="cover-stamp" src="{{ logo }}" alt="Agrupamento 994 Caxinas">
    </main>

    {% elif s.tipo == "fazem" %}
    <main class="content{% if foto_fundo %} has-content-photo{% endif %}"{% if foto_fundo %} style="--content-photo: url('{{ foto_fundo }}'); --content-photo-pos: {{ foto_fundo_pos }};"{% endif %}>
      <div class="content-heading">
        <p class="eyebrow">02 / UM SÁBADO QUALQUER</p>
        {% if s.titulo is string %}
        <h1>{{ s.titulo }}</h1>
        {% else %}
        <h1>{% for line in s.titulo %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h1>
        {% endif %}
        {% if s.sub %}<p class="lead">{{ s.sub }}</p>{% endif %}
        {% if s.intro %}<p class="lead">{{ s.intro }}</p>{% endif %}
      </div>

      {% if s.citacao %}
      <blockquote>“{{ s.citacao|replace("»", "")|replace("«", "") }}”<cite>{{ s.autor }}</cite></blockquote>
      {% endif %}

      {% if s.cartoes %}
      <div class="cards">
        {% for card in s.cartoes %}
        <article class="card" style="--card-color: {{ card.cor }};">
          {% if card.icone %}<div class="card-icon">{{ card.icone }}</div>{% endif %}
          <span class="card-index">0{{ loop.index }}</span>
          <h2>{{ card.nome }}</h2>
          <p>{{ card.texto }}</p>
        </article>
        {% endfor %}
      </div>
      {% else %}
      {% set steps = s.etapas or s.passos or s.itens %}
      <div class="steps">
        {% for step in steps %}
        <article class="step">
          <span class="step-index">0{{ loop.index }}</span>
          <div><h2>{{ step[0] }}</h2><p>{{ step[1] }}</p></div>
        </article>
        {% endfor %}
      </div>
      {% endif %}
    </main>

    {% elif s.tipo in ["bandos", "patrulhas", "equipas", "tribos"] %}
    <main class="content groups-page{% if foto_fundo %} has-content-photo{% endif %}"{% if foto_fundo %} style="--content-photo: url('{{ foto_fundo }}'); --content-photo-pos: {{ foto_fundo_pos }};"{% endif %}>
      <div class="content-heading">
        <p class="eyebrow">03 / COM QUEM CRESCEMOS</p>
        <h1>{{ s.titulo if s.titulo is string else s.titulo|join(" ") }}</h1>
        <p class="lead">{{ s.sub or s.lead }}</p>
      </div>
      {% set groups = s.bandos or s.patrulhas or s.equipas or s.tribos %}
      <div class="groups">
        {% for group in groups %}
        <article class="group">
          <div class="group-image">
            {% if group.img %}<img src="{{ ag(group.img) }}" alt="">{% endif %}
          </div>
          <div>
            <span class="group-index">0{{ loop.index }}</span>
            <h2>{{ group.nome }}</h2>
            {% if group.lema %}<p>{{ group.lema }}</p>{% endif %}
            {% if group.papel %}<p>{{ group.papel }}</p>{% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
      <p class="group-note">{{ s.nota|safe }}</p>
    </main>

    {% elif s.tipo == "fim" %}
    <main class="closing">
      <div class="closing-photo photo" style="--photo: url('{{ foto }}'); --photo-pos: {{ foto_pos }};"></div>
      <div class="closing-panel">
        <p class="eyebrow">04 / SE FIZER SENTIDO PARA TI</p>
        {% if s.titulo %}
          {% if s.titulo is string %}<h1>{{ s.titulo }}</h1>
          {% else %}<h1>{% for line in s.titulo %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h1>{% endif %}
        {% else %}<h1>{{ s.lema }}</h1>{% endif %}
        <p class="closing-meaning">{{ s.significado }}</p>
        <p class="closing-invite">{{ s.convite }}</p>
        <div class="contacts">
          {% for contact in s.contactos %}
            {% if contact is string %}<span>{{ contact }}</span>{% else %}<span><b>{{ contact[0] }}</b>{{ contact[1] }}</span>{% endif %}
          {% endfor %}
        </div>
      </div>
    </main>
    {% endif %}

    <footer class="footer">
      <span>{{ parte.unidade_nome }} / {{ parte.unidade_patrono }}</span>
      <span>994CAXINAS.COM</span>
    </footer>
  </div>
</body>
</html>
