<!doctype html>
<html lang="pt"><head><meta charset="utf-8"><style>{{ css }}</style></head>
<body>
{% macro folha(x, y, rot, sc, cor, z=1) %}
<g class="folha" transform="translate({{x}},{{y}}) rotate({{rot}}) scale({{sc}})">
  <path d="M0,0 C 50,-78 168,-92 260,0 C 168,92 50,78 0,0 Z" fill="rgb({{cor}})"/>
  <path d="M8,0 L 246,0 M70,0 L118,-38 M120,0 L170,-40 M70,0 L118,38 M120,0 L170,40" stroke="#fff" stroke-opacity=".3" stroke-width="6" fill="none" stroke-linecap="round"/>
</g>
{% endmacro %}
{% macro selva(lista) %}
<svg class="selva" viewBox="0 0 1080 1350" width="1080" height="1350">
  {% for f in lista %}{{ folha(f[0], f[1], f[2], f[3], ['23 104 45','46 140 63','102 175 72','15 74 33'][f[4]]) }}{% endfor %}
</svg>
{% endmacro %}
{% macro sol_idade(txt1, txt2) %}
<div class="idade"><svg viewBox="-130 -130 260 260">
  {% for k in range(14) %}<path d="M0,-126 L13,-92 L-13,-92Z" fill="#F2761D" transform="rotate({{ k * 360 / 14 }})"/>{% endfor %}
  <circle r="96" fill="#F2761D"/><circle r="84" fill="none" stroke="#fff" stroke-width="4" stroke-dasharray="6 9" opacity=".7"/></svg>
  <span>{{ txt1 }}<small>{{ txt2 }}</small></span></div>
{% endmacro %}
{% macro titulo(txt) %}{% for ch in txt %}{% if ch == ' ' %} {% else %}<i style="transform: rotate({{ [-4, 3, -2, 4, -3, 2, -1][loop.index0 % 7] }}deg) translateY({{ [0, -10, 4, -6, 6, -4, 2][loop.index0 % 7] }}px)">{{ ch }}</i>{% endif %}{% endfor %}{% endmacro %}

<div class="slide t-{{ s.tipo }}">
  <div class="sol"></div>

  {% if s.tipo == 'capa' %}
    {{ selva([(-60,1390,-58,1.3,3),(20,1400,-80,1.0,1),(1120,1280,-140,1.4,0),(1010,1360,-110,1.1,2),(1100,1150,-160,1.0,3),(-60,120,30,1.0,2),(-30,40,60,0.8,1),(-80,260,10,0.9,0)]) }}
    <div class="blob"><div style="background-image:url('{{ ft(s.foto) }}'); background-position:{{ s.foto_pos|default('50% 50%') }}"></div></div>
    {{ sol_idade(s.idade_n, 'ANOS') }}
    <div class="sticker">{{ titulo(s.titulo) }}</div>
    <div class="fita">{{ s.lema }}</div>
    <p class="chamada">{{ s.chamada }}</p>

  {% elif s.tipo == 'fazem' %}
    {{ selva([(1120,140,170,1.2,2),(1080,40,150,0.9,0),(1110,260,190,0.8,3),(-40,1360,-60,1.3,3),(-70,1250,-30,1.0,1),(1110,1370,-120,1.3,1)]) }}
    <div class="sticker">{{ titulo(s.titulo) }}</div>
    <div class="cartoes">
      {% for c in s.cartoes %}
      <div class="cartao"><div class="ic" style="background:{{ c.cor }}">{{ c.icone|safe }}</div><h3>{{ c.nome }}</h3><p>{{ c.texto }}</p></div>
      {% endfor %}
    </div>

  {% elif s.tipo == 'bandos' %}
    {{ selva([(1120,130,160,1.1,1),(-80,1420,-50,1.0,0),(1110,1380,-125,1.2,3)]) }}
    <div class="sticker">{{ titulo(s.titulo) }}</div>
    <p class="sub">{{ s.sub }}</p>
    <div class="lobos">
      {% for b in s.bandos %}{% set pos = [(60,40),(410,0),(760,40),(230,320),(590,320)][loop.index0] %}
      <div class="lobo" style="left:{{ pos[0] }}px; top:{{ pos[1] }}px; transform: rotate({{ [-5,3,-2,4,-4][loop.index0] }}deg)">
        <div class="cara"><img src="{{ ag(b.img) }}"></div><b>{{ b.nome }}</b></div>
      {% endfor %}
    </div>
    <p class="nota">{{ s.nota|safe }}</p>

  {% elif s.tipo == 'fim' %}
    {{ selva([(1120,120,165,1.2,0),(-40,1380,-60,1.1,2),(140,1395,-95,1.0,3)]) }}
    <div class="sticker">{% for l in s.titulo %}<div>{{ titulo(l) }}</div>{% endfor %}</div>
    <p class="sig">{{ s.significado }}</p>
    <div class="blob"><div style="background-image:url('{{ ft(s.foto) }}'); background-position:{{ s.foto_pos|default('50% 50%') }}"></div></div>
    <div class="convite"><h3>{{ s.convite }}</h3><p>{% for c in s.contactos %}{{ c }}<br>{% endfor %}</p></div>
  {% endif %}

  <div class="ancora">As Nossas Secções · I</div>
  {% if logo %}<img class="logo" src="{{ logo }}" style="height:{{ logo_h }}px">{% endif %}
  <div class="grao"></div>
</div>
<script>document.fonts.ready.then(() => { document.body.dataset.pronto = '1'; });</script>
</body></html>
