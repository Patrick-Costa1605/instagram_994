<!doctype html>
<html lang="pt"><head><meta charset="utf-8"><style>{{ css }}</style></head>
<body>
{% macro rosa(x, y, r) %}
<svg class="rosa" style="left:{{ x - r }}px; top:{{ y - r }}px" width="{{ 2*r }}" height="{{ 2*r }}" viewBox="-100 -100 200 200">
  <circle r="92" fill="none" stroke="#2A2417" stroke-width="2"/><circle r="80" fill="none" stroke="#2A2417" stroke-width="1" stroke-dasharray="2 6"/>
  {% for k in range(8) %}<path d="M0,-{{ 88 if k % 2 == 0 else 52 }} L9,0 L0,{{ 0 }} Z" fill="{{ '#2A2417' if k % 2 == 0 else '#6F7F3C' }}" transform="rotate({{ k * 45 }})"/>
  <path d="M0,-{{ 88 if k % 2 == 0 else 52 }} L-9,0 L0,0 Z" fill="{{ '#D6582A' if k == 0 else '#F0E7CF' }}" stroke="#2A2417" stroke-width="1" transform="rotate({{ k * 45 }})"/>{% endfor %}
  <circle r="7" fill="#2A2417"/><text y="-96" text-anchor="middle" font-family="Stencil" font-size="26" fill="#2A2417">N</text>
</svg>
{% endmacro %}
<div class="slide t-{{ s.tipo }}">
  <div class="topo">{{ motivo|safe }}</div>
  <div class="dobra"></div>
  <div class="moldura"></div>
  <div class="reguas">
    {% for k in range(6) %}<span style="left:{{ 100 + k * 170 }}px; top:10px">{{ 'ABCDEF'[k] }}</span><span style="left:{{ 100 + k * 170 }}px; bottom:8px">{{ 'ABCDEF'[k] }}</span>{% endfor %}
    {% for k in range(7) %}<span style="left:12px; top:{{ 110 + k * 180 }}px">{{ k + 1 }}</span><span style="right:12px; top:{{ 110 + k * 180 }}px">{{ k + 1 }}</span>{% endfor %}
  </div>

  {% if s.tipo == 'capa' %}
    <div class="foto"><div style="background-image:url('{{ ft(s.foto) }}'); background-position:{{ s.foto_pos|default('50% 50%') }}"></div><p>{{ s.legenda }}</p></div>
    <div class="fita-c" style="left:440px; top:140px; transform:rotate(-4deg)"></div>
    <div class="carimbo"><div><b>{{ s.idade_n }}</b><small>ANOS</small></div></div>
    <div class="stencil" data-fit="940">{{ s.titulo }}</div>
    <div class="etiqueta">{{ s.lema }}</div>
    <p class="chamada">{{ s.chamada }}</p>

  {% elif s.tipo == 'fazem' %}
    <div class="stencil">{{ s.titulo }}</div>
    <p class="intro">{{ s.intro }}</p>
    <svg class="trilho" viewBox="0 0 1080 1350"><path d="M 170 470 C 120 600, 260 640, 230 760 S 120 900, 190 1010 S 360 1130, 560 1150" fill="none" stroke="#D6582A" stroke-width="7" stroke-dasharray="4 18" stroke-linecap="round"/></svg>
    {% for p in s.etapas %}{% set pos = [(270,470),(320,720),(300,960)][loop.index0] %}
    <div class="ponto" style="left:{{ pos[0] }}px; top:{{ pos[1] }}px"><div class="n">{{ loop.index }}</div><h3>{{ p[0] }}</h3><p>{{ p[1] }}</p></div>
    {% endfor %}
    <div class="x" style="left:560px; top:1100px; font-size:120px">✕</div>
    <div class="x" style="left:650px; top:1135px; font-size:40px; letter-spacing:4px">{{ s.destino }}</div>
    {{ rosa(900, 420, 74) }}

  {% elif s.tipo == 'patrulhas' %}
    <div class="stencil">{{ s.titulo }}</div>
    <p class="sub">{{ s.sub }}</p>
    {% for p in s.patrulhas %}{% set pos = [(90,470),(415,430),(740,480),(240,770),(590,780)][loop.index0] %}
    <div class="pin" style="left:{{ pos[0] }}px; top:{{ pos[1] }}px"><img src="{{ ag(p.img) }}"><b>{{ p.nome }}</b><em>{{ p.lema }}</em></div>
    {% endfor %}
    <div class="legenda"><b>LEGENDA</b>{{ s.nota|safe }}</div>

  {% elif s.tipo == 'fim' %}
    <div class="etiqueta">{{ s.lema }}</div>
    <p class="sig">{{ s.significado }}</p>
    <div class="foto"><div style="background-image:url('{{ ft(s.foto) }}'); background-position:{{ s.foto_pos|default('50% 50%') }}"></div><p>{{ s.legenda }}</p></div>
    <div class="fita-c" style="left:740px; top:530px; transform:rotate(6deg)"></div>
    <div class="ficha"><h3>{{ s.convite }}</h3><p>{% for c in s.contactos %}{{ c }}<br>{% endfor %}</p></div>
    {{ rosa(180, 1130, 90) }}
  {% endif %}

  <div class="ancora">As Nossas Secções · II</div>
  {% if logo %}<img class="logo" src="{{ logo }}" style="height:{{ logo_h }}px">{% endif %}
  <div class="grao"></div>
</div>
<script>
document.fonts.ready.then(() => {
  document.querySelectorAll('[data-fit]').forEach(el => { const max = +el.dataset.fit; el.style.width = 'max-content';
    const w = el.getBoundingClientRect().width; if (w > max) el.style.fontSize = (parseFloat(getComputedStyle(el).fontSize) * max / w) + 'px'; });
  document.body.dataset.pronto = '1'; });
</script>
</body></html>
