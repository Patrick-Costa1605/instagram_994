<!doctype html>
<html lang="pt"><head><meta charset="utf-8"><style>{{ css }}</style></head>
<body>
<div class="slide t-{{ s.tipo }} {{ 'claro' if s.tipo in ('capa', 'fim') else '' }}">

  {% if s.tipo == 'capa' %}
    <div class="duo"><div style="background-image:url('{{ ft(s.foto) }}'); background-position:{{ s.foto_pos|default('50% 50%') }}"></div></div>
    <div class="mast" data-fit="960">{{ s.titulo }}</div>
    <div class="linha-mast kicker"><span>{{ s.esq }}</span><span>{{ s.meio }}</span><span>{{ s.dir }}</span></div>
    <div class="capa-servir">{{ s.lema }}</div>
    <p class="capa-sub">{{ s.sub }}</p>

  {% elif s.tipo == 'fazem' %}
    <p class="citacao">{{ s.citacao }}</p>
    <div class="autor kicker">— {{ s.autor }}</div>
    <div class="regra"></div>
    <div class="colunas">{% for c in s.itens %}<div class="col"><div class="num">{{ loop.index }}</div><div><h3>{{ c[0] }}</h3><p>{{ c[1] }}</p></div></div>{% endfor %}</div>

  {% elif s.tipo == 'tribos' %}
    <h2>{{ s.titulo[0] }} <em>{{ s.titulo[1] }}</em></h2>
    <p class="lead">{{ s.lead }}</p>
    <div class="retratos">{% for t in s.tribos %}<div class="retrato"><div class="duo"><div style="background-image:url('{{ ag(t.img) }}')"></div></div><h4>{{ t.nome }}</h4><small class="kicker">{{ t.papel }}</small></div>{% endfor %}</div>
    <p class="rodape">{{ s.nota }}</p>

  {% elif s.tipo == 'fim' %}
    <div class="servir">{{ s.lema }}</div>
    <p class="sig">{{ s.significado }}</p>
    <div class="duo"><div style="background-image:url('{{ ft(s.foto) }}'); background-position:{{ s.foto_pos|default('50% 50%') }}"></div></div>
    <div class="convite"><h3>{{ s.convite }}</h3><p>{% for c in s.contactos %}{{ c }}<br>{% endfor %}</p></div>
  {% endif %}

  <div class="ancora">As Nossas Secções · IV</div>
  {% if logo %}<img class="logo" src="{{ logo }}" style="height:{{ logo_h }}px">{% endif %}
  <div class="grao"></div>
</div>
<script>
document.fonts.ready.then(() => {
  document.querySelectorAll('[data-fit]').forEach(el => { const max = +el.dataset.fit; const w0 = el.scrollWidth;
    const span = document.createElement('span'); span.textContent = el.textContent; span.style.whiteSpace = 'nowrap'; el.textContent = ''; el.appendChild(span);
    const w = span.getBoundingClientRect().width; if (w > max) el.style.fontSize = (parseFloat(getComputedStyle(el).fontSize) * max / w) + 'px'; });
  document.body.dataset.pronto = '1'; });
</script>
</body></html>
