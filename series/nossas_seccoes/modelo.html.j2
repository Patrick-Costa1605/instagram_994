<!doctype html>
<html lang="pt"><head><meta charset="utf-8">
<style>:root { --acento: {{ tons.acento }}; --kick: {{ tons.kick }}; --profundo: {{ tons.profundo }}; }
{{ css }}</style></head>
<body>
<div class="pan" style="width:{{ n * W }}px; height:{{ H }}px">
  <div class="papel"></div>
  <div class="fibra"></div>
  {{ cordel|safe }}

  {% for sl in slides %}{% set i = loop.index0 %}
  <section class="sl t-{{ sl.tipo }}" style="left:{{ i * W }}px">

    {# ---- barra de cima: rótulo + posição #}
    <div class="topo"><span>{{ sl.kicker_esq|default(sl.kicker|default(cabecalho)) }}</span><span>{{ sl.kicker_dir|default('%d/%d'|format(i + 1, n)) }}</span></div>

    {% if sl.tipo == 'capa' %}
      {% if sl.emblema_tipo == 'selo' %}<div class="selo"><img src="{{ ag(sl.emblema) }}"></div>
      {% elif sl.emblema_tipo == 'cracha' %}<img class="cracha" src="{{ ag(sl.emblema) }}">
      {% elif sl.emblema_tipo == 'foto' %}<div class="hero-foto" style="background-image:url('{{ ag(sl.emblema) }}')"></div>{% endif %}
      <h1 class="nome-capa n{{ sl.titulo|length }}">{% for l in sl.titulo %}<span>{{ l }}</span>{% endfor %}</h1>
      <div class="sub-capa">{{ sl.sub }}</div>
      {% if sl.tres %}<div class="tres">{% for t in sl.tres %}<span>{{ t }}</span>{% endfor %}</div>{% endif %}

    {% elif sl.tipo == 'glossario' %}
      <h1 class="h1">{% for l in sl.titulo %}<span>{{ l }}</span>{% endfor %}</h1>
      <div class="gloss">{% for it in sl.itens %}<div class="g-linha"><b>{{ it[0] }}</b><p>{{ it[1] }}</p></div>{% endfor %}</div>

    {% elif sl.tipo == 'grupos' %}
      <h1 class="h1">{% for l in sl.titulo %}<span>{{ l }}</span>{% endfor %}</h1>
      <p class="sub">{{ sl.sub }}</p>
      <div class="meds t-{{ sl.tam }}">
        {% for it in sl.itens %}
        <figure class="med"><div class="disco {{ it.forma|default('') }}"><img src="{{ ag(it.img) }}"></div>
          <figcaption><b>{{ it.nome }}</b>{% if it.nota %}<em>{{ it.nota }}</em>{% endif %}</figcaption></figure>
        {% endfor %}
      </div>
      {% if sl.grito %}<div class="grito"><small>{{ sl.grito_rotulo }}</small><q>{{ sl.grito }}</q></div>{% endif %}

    {% elif sl.tipo == 'entrar' %}
      {% if sl.foto %}<div class="foto-faixa" style="background-image:url('{{ ag(sl.foto) }}')"></div>{% endif %}
      <h1 class="h1 {{ 'com-foto' if sl.foto else '' }}">{% for l in sl.titulo %}<span>{{ l }}</span>{% endfor %}</h1>
      <ol class="passos {{ 'com-foto' if sl.foto else '' }}">{% for p in sl.passos %}<li><i>{{ loop.index }}</i><span>{{ p }}</span></li>{% endfor %}</ol>
      <div class="contacto">{% for l in sl.contactos %}<div>{{ l }}</div>{% endfor %}</div>

    {% elif sl.tipo == 'tabela' %}
      <h1 class="h1">{% for l in sl.titulo %}<span>{{ l }}</span>{% endfor %}</h1>
      <div class="tabela">{% for r in sl.linhas %}
        <div class="t-linha" style="--c:{{ r.cor }}"><span class="idade">{{ r.idade }}</span>
          <div class="disco pequeno"><img src="{{ ag(r.img) }}"></div>
          <div class="t-txt"><b>{{ r.nome }}</b><em>{{ r.unidade }} · {{ r.atividade }}</em></div></div>{% endfor %}
      </div>

    {% elif sl.tipo == 'pertenca' %}
      <h1 class="h1">{% for l in sl.titulo %}<span>{{ l }}</span>{% endfor %}</h1>
      <div class="pert">{% for r in sl.itens %}
        <div class="p-linha"><div class="p-logo"><img src="{{ ag(r.img) }}"></div><div><b>{{ r.nome }}</b><p>{{ r.texto }}</p></div></div>{% endfor %}
      </div>

    {% elif sl.tipo == 'qa' %}
      <h1 class="h1 pequeno">{% for l in sl.titulo %}<span>{{ l }}</span>{% endfor %}</h1>
      <div class="qa">{% for q in sl.itens %}<div class="qa-bloco"><h3>{{ q.p }}</h3><p>{{ q.r }}</p></div>{% endfor %}</div>
      {% if sl.fonte %}<div class="fonte">{{ sl.fonte }}</div>{% endif %}
    {% endif %}

    {% if logo %}<img class="logo" src="{{ logo }}" style="height:{{ logo_h }}px">{% endif %}
    <div class="pe">{% if i < n - 1 %}desliza <svg width="46" height="16" viewBox="0 0 46 16"><path d="M2 8 H42 M35 2 L43 8 L35 14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>{% else %}994 · caxinas{% endif %}</div>
  </section>
  {% endfor %}
</div>
<script>
  document.fonts.ready.then(() => {
    document.querySelectorAll('.nome-capa, .h1').forEach(el => {
      const max = 920;
      const w = Math.max(...[...el.querySelectorAll('span')].map(s => s.getBoundingClientRect().width));
      if (w > max) el.style.fontSize = (parseFloat(getComputedStyle(el).fontSize) * max / w) + 'px';
    });
    document.body.dataset.pronto = '1';
  });
</script>
</body></html>
