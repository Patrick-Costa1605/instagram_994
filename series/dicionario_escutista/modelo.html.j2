<!doctype html>
<html lang="pt"><head><meta charset="utf-8">
<style>:root { {% for k, v in cores.items() %}--{{ k }}: {{ v }};{% endfor %} }
{{ css }}</style></head>
<body>
<div class="slide {{ s.tipo }}">
  <div class="foto {{ 'vazia' if not foto else '' }}" {% if foto %}style="background-image:url('{{ foto }}'); background-position:{{ foto_pos }}; background-size:{{ foto_zoom }}"{% endif %}></div>
  <div class="velo"></div>

  {% if s.tipo == 'capa' %}
    <div class="titulo" data-fit="940">{% for l in s.titulo %}<span class="linha">{{ l }}</span>{% endfor %}</div>
    <div class="subtitulo">{{ s.subtitulo }}</div>

  {% elif s.tipo == 'termo' %}
    <div class="cabecalho">{% for l in cabecalho %}{{ l }}<br>{% endfor %}</div>
    <div class="bloco">
      <div class="titulo" data-fit="920">{% for l in s.termo %}<span class="linha {{ 'banda' if loop.last else '' }}">{{ l }}</span>{% endfor %}</div>
      <div class="regua"></div>
      <div class="texto">{{ texto|safe }}</div>
    </div>

  {% elif s.tipo == 'cta' %}
    <div class="cabecalho">{% for l in cabecalho %}{{ l }}<br>{% endfor %}</div>
    <div class="bloco">
      <div class="titulo" data-fit="920">{% for l in s.titulo %}<span class="linha">{{ l }}</span>{% endfor %}</div>
      <div class="regua4"><i style="background:var(--amarelo)"></i><i style="background:var(--verde)"></i><i style="background:var(--azul)"></i><i style="background:var(--vermelho)"></i></div>
      <div class="texto">{{ texto|safe }}</div>
      <div class="botao">{{ s.botao }}</div>
    </div>
  {% endif %}

  {% if s.tipo != 'cta' and rodape %}
  <div class="arrasta">{{ rodape }}
    <svg width="210" height="30" viewBox="0 0 210 30"><path d="M2 15 H196 M178 3 L198 15 L178 27" fill="none" stroke="var(--amarelo)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>
  {% endif %}
  {% if logo %}
  <div class="logo {{ 'fundo' if logo_fundo else '' }}" style="{% if logo_fundo %}width:{{ logo_h + 24 }}px;height:{{ logo_h + 24 }}px{% endif %}">
    <img src="{{ logo }}" style="height:{{ logo_h }}px">
  </div>
  {% endif %}
</div>
<script>
  // reduz o título se alguma linha ultrapassar a largura máxima (nunca amplia)
  document.fonts.ready.then(() => {
    document.querySelectorAll('.titulo[data-fit]').forEach(t => {
      const max = parseFloat(t.dataset.fit);
      const w = Math.max(...[...t.querySelectorAll('.linha')].map(l => l.getBoundingClientRect().width));
      if (w > max) t.style.fontSize = (parseFloat(getComputedStyle(t).fontSize) * max / w) + 'px';
    });
    // texto longo: reduz até caber acima do rodapé (limite definido por data-limite no .bloco)
    const bloco = document.querySelector('.bloco'), txt = document.querySelector('.bloco .texto');
    if (bloco && txt) {
      let fs = parseFloat(getComputedStyle(txt).fontSize);
      while (bloco.getBoundingClientRect().bottom > 1150 && fs > 32) { fs -= 2; txt.style.fontSize = fs + 'px'; }
    }
    document.body.dataset.pronto = '1';
  });
</script>
</body></html>
